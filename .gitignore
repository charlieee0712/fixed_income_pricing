# =============================================================================
#  .gitignore
#  POLICY CHANGE 2026-07-08 (boss-approved): client data is now TRACKED in-repo.
#  This repository intentionally contains the client portfolio, the proprietary
#  reference workbooks/curves, and derived reports. It MUST stay PRIVATE.
#  Only machine-local build/cache/editor artifacts are excluded below.
# =============================================================================

# ---- Regenerable / working artifacts (not source, rebuilt on server 47) ----
extracted/
scratchpad/
outputs/
*.bak

# ---- Google-Drive staging copies (curated duplicates of this tree; never commit) ----
corporate_bond/
code_structure_sample/
code_structure_sample_*.zip
handoff_for_claude_web_*.zip

# ---- Obsolete root code-delivery zips (removed from the branch 2026-08-31) ----
# fixed_income_code_v1/v2/v3/v3.1.zip were whole-tree snapshots handed over in June and
# July. Their contents are already in this repository's history, they are not a runtime
# dependency and not golden data, and sitting at the root they read as the CURRENT delivery
# package -- which is `code_structure_sample/`. Removed from the branch (history untouched,
# so `git show <old-commit>:fixed_income_code_v3.zip > out.zip` still recovers any of them),
# and ignored here so a stray rebuild cannot re-add one. Anchored to the root on purpose:
# data/*.zip are TRACKED source data and must never match this.
/fixed_income_code_v*.zip

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Claude Code local settings ----
.claude/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# ---- Demo runner: machine-specific paths, regenerated by Build-DemoWorkbook.ps1 ----
integrations/excel_vba/demo/run_engine.cmd

# ---- Handoff bundles (uploaded to the claude.ai Project; regenerated on request) ----
handoff1_*.zip
handoff2_*.zip

# Excel lock files (created while a workbook is open)
~$*
# undated staging zip (superseded by the dated ones above)
code_structure_sample.zip
